<div class="col-head t-1" aria-hidden="true"><svg class="icon"><use href="#i-square"/></svg><span>Bass</span></div>
<button type="button" class="clip t-1 is-off" data-t="1" data-c="0" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-square"/></svg><svg class="pad-glyph glyph-wait" aria-hidden="true"><use href="#i-hourglass"/></svg><svg class="pad-glyph glyph-stop" aria-hidden="true"><use href="#i-stop"/></svg><span class="vh pad-label">Bass 1</span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
