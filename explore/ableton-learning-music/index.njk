<main id="alm">
<h1 data-i18n="title">Buat Lagu</h1>
<p class="alm-intro" data-i18n="intro">Pilih satu kotak di setiap kolom.</p>
<p id="hint-tap" data-i18n="tap">Ketuk kotak untuk memulai. Ketuk lagi untuk berhenti.</p>
<p id="hint-noaudio" data-i18n="noAudio" hidden>Browser ini tidak bisa memutar suara.</p>
<section id="session" role="group" aria-label="Lagu kamu">
<div class="grid">
<div class="col-head t-0" aria-hidden="true"><svg class="icon"><use href="#i-circle"/></svg><span data-i18n="track0">Drum</span></div>
<button type="button" class="clip t-0 is-off" data-t="0" data-c="0" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-circle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-0 is-off" data-t="0" data-c="1" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-circle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-0 is-off" data-t="0" data-c="2" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-circle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-0 is-off" data-t="0" data-c="3" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-circle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<div class="col-head t-1" aria-hidden="true"><svg class="icon"><use href="#i-square"/></svg><span data-i18n="track1">Bass</span></div>
<button type="button" class="clip t-1 is-off" data-t="1" data-c="0" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-square"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-1 is-off" data-t="1" data-c="1" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-square"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-1 is-off" data-t="1" data-c="2" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-square"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-1 is-off" data-t="1" data-c="3" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-square"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<div class="col-head t-2" aria-hidden="true"><svg class="icon"><use href="#i-triangle"/></svg><span data-i18n="track2">Akord</span></div>
<button type="button" class="clip t-2 is-off" data-t="2" data-c="0" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-triangle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
<button type="button" class="clip t-2 is-off" data-t="2" data-c="1" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-triangle"/></svg><span class="vh pad-label"></span><span class="vh pad-state"></span><span class="progress" aria-hidden="true"></span></button>
