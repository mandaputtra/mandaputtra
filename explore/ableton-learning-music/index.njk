<main id="alm">
<h1>Make a Song</h1>
<p class="alm-intro">Pick a box in each column.</p>
<p id="hint-tap">Tap a box to start it. Tap again to stop.</p>
<p id="hint-noaudio" hidden>This browser cannot play the sounds.</p>
<section id="session" role="group" aria-labelledby="session-h">
<h2 id="session-h">Your song</h2>
